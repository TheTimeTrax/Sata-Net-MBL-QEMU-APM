diff --git a/hw/ide/apm821xx-sata.c b/hw/ide/apm821xx-sata.c
new file mode 100644
index 0000000..6b9bc4d
--- /dev/null
+++ b/hw/ide/apm821xx-sata.c
@@ -0,0 +1,448 @@
+/*
+ * AppliedMicro APM821xx / 460EX DesignWare SATA controller.
+ *
+ * This first model provides the legacy ATA task-file, SATA SCR and DWC
+ * identification/interrupt registers used by sata_dwc_460ex.  It delegates
+ * ATA PIO command execution to QEMU's IDE core.  DesignWare slave-DMA data
+ * transfers are intentionally a subsequent implementation step.
+ */
+#include "qemu/osdep.h"
+#include "hw/core/sysbus.h"
+#include "hw/core/qdev-properties.h"
+#include "hw/core/irq.h"
+#include "hw/ide/apm821xx-sata.h"
+#include "migration/vmstate.h"
+#include "qapi/error.h"
+#include "qemu/log.h"
+#include "qemu/module.h"
+#include "system/dma.h"
+#include "system/blockdev.h"
+#include "ide-internal.h"
+
+#define APM_SATA_MMIO_SIZE       0x800
+#define APM_SATA_SCR_BASE        0x024
+#define APM_SATA_DWC_BASE        0x064
+#define APM_SATA_DWC_INTPR       (APM_SATA_DWC_BASE + 0x14)
+#define APM_SATA_DWC_INTMR       (APM_SATA_DWC_BASE + 0x18)
+#define APM_SATA_DWC_VERSIONR    (APM_SATA_DWC_BASE + 0x94)
+#define APM_SATA_DWC_IDR         (APM_SATA_DWC_BASE + 0x98)
+
+/* Synopsys DesignWare AHB DMAC, as integrated by APM821xx. */
+#define APM_AHBDMA_MMIO_SIZE     0x800
+#define APM_AHBDMA_CHAN_SIZE     0x58
+/* Eight 0x58-byte channel banks precede the common AHB-DMAC registers. */
+#define APM_AHBDMA_CH_EN         0x3a0
+#define APM_AHBDMA_RAW_XFER       0x2c0
+#define APM_AHBDMA_STATUS_XFER    0x2e8
+#define APM_AHBDMA_MASK_XFER      0x310
+#define APM_AHBDMA_MASK_ERROR     0x330
+#define APM_AHBDMA_CLEAR_XFER    0x338
+#define APM_AHBDMA_STATUS_INT     0x360
+#define APM_AHBDMA_DMA_CFG       0x398
+#define APM_AHBDMA_CH_LLP(ch)    ((ch) * APM_AHBDMA_CHAN_SIZE + 0x010)
+#define APM_AHBDMA_CH_CTL_HI(ch) ((ch) * APM_AHBDMA_CHAN_SIZE + 0x01c)
+#define APM_AHBDMA_LLI_SIZE      0x1c
+
+#define APM_SATA_INTPR_DMAT      0x00000001
+#define APM_SATA_SSTATUS_PRESENT 0x00000123
+
+typedef struct APMAHBDMALLI {
+    uint32_t sar;
+    uint32_t dar;
+    uint32_t llp;
+    uint32_t ctllo;
+    uint32_t ctlhi;
+    uint32_t sstat;
+    uint32_t dstat;
+} QEMU_PACKED APMAHBDMALLI;
+
+struct APM821xxSATAState {
+    SysBusDevice parent_obj;
+    IDEBus bus;
+    MemoryRegion mmio;
+    MemoryRegion dma_mmio;
+    qemu_irq irq;
+    qemu_irq dma_irq;
+    qemu_irq ide_irq;
+    IDEDMA dma;
+    BlockCompletionFunc *dma_cb;
+    uint32_t dma_regs[APM_AHBDMA_MMIO_SIZE / sizeof(uint32_t)];
+    bool dma_running;
+    bool drive_present;
+    uint8_t dma_channel;
+    uint32_t regs[APM_SATA_MMIO_SIZE / sizeof(uint32_t)];
+};
+
+static void apm821xx_sata_update_irq(APM821xxSATAState *s, int level)
+{
+    /*
+     * The IDE core raises this for an ordinary ATA command completion.
+     * NEWFP is only a received NCQ DMA-Setup FIS; advertising it here makes
+     * sata_dwc_460ex start the same DMA transaction a second time.
+     */
+    qemu_set_irq(s->irq, level);
+}
+
+static void apm821xx_sata_ide_irq(void *opaque, int n, int level)
+{
+    APM821xxSATAState *s = opaque;
+
+    apm821xx_sata_update_irq(s, level);
+}
+
+/*
+ * The Linux dw_dmac driver builds little-endian linked-list items in RAM.
+ * The controller uses the SATA FIFO as one side of each transfer.  QEMU's
+ * IDE core can directly scatter/gather between the backing block device and
+ * guest RAM, so this model consumes those items and hands their RAM side to
+ * the core.  That preserves the guest-visible DMA programming model without
+ * adding a needless FIFO copy on the host.
+ */
+static int32_t apm821xx_sata_dma_prepare(const IDEDMA *dma, int32_t limit)
+{
+    APM821xxSATAState *s = container_of(dma, APM821xxSATAState, dma);
+    IDEState *ide = ide_bus_active_if(&s->bus);
+    hwaddr lli_addr = s->dma_regs[APM_AHBDMA_CH_LLP(s->dma_channel) / 4] &
+                      ~3U;
+    unsigned int entries = 0;
+
+    qemu_log_mask(LOG_UNIMP, "mbl-ahbdma: prepare channel%u llp=%08" HWADDR_PRIx
+                  " limit=%d\n", s->dma_channel, lli_addr, limit);
+    qemu_sglist_init(&ide->sg, DEVICE(s), 8, &address_space_memory);
+    ide->io_buffer_size = 0;
+
+    while (lli_addr && entries++ < 128 && ide->sg.size < limit) {
+        APMAHBDMALLI lli;
+        hwaddr mem_addr;
+        uint32_t bytes;
+        MemTxResult result;
+
+        result = dma_memory_read(&address_space_memory, lli_addr, &lli,
+                                 sizeof(lli), MEMTXATTRS_UNSPECIFIED);
+        if (result != MEMTX_OK) {
+            return -1;
+        }
+        lli.sar = le32_to_cpu(lli.sar);
+        lli.dar = le32_to_cpu(lli.dar);
+        lli.llp = le32_to_cpu(lli.llp);
+        lli.ctlhi = le32_to_cpu(lli.ctlhi);
+
+        /* APM821xx programs BLOCK_TS as a count of 4-byte SATA words. */
+        bytes = (lli.ctlhi & 0xfffU) * 4;
+        /* The 32-bit DMA address of SATA0's DWC FIFO is 0xbffd1400. */
+        mem_addr = (lli.sar == 0xbffd1400U) ? lli.dar : lli.sar;
+        qemu_log_mask(LOG_UNIMP,
+                      "mbl-ahbdma: lli%u sar=%08x dar=%08x next=%08x"
+                      " ctlhi=%08x bytes=%u mem=%08" HWADDR_PRIx "\n",
+                      entries, lli.sar, lli.dar, lli.llp, lli.ctlhi, bytes,
+                      mem_addr);
+        if (mem_addr == 0xbffd1400U || bytes == 0) {
+            return -1;
+        }
+        bytes = MIN(bytes, (uint32_t)(limit - ide->sg.size));
+        qemu_sglist_add(&ide->sg, mem_addr, bytes);
+        ide->io_buffer_size += bytes;
+        lli_addr = lli.llp & ~3U;
+    }
+
+    return ide->sg.size ? ide->sg.size : -1;
+}
+
+static void apm821xx_sata_dma_commit(const IDEDMA *dma, uint32_t bytes)
+{
+    APM821xxSATAState *s = container_of(dma, APM821xxSATAState, dma);
+    uint32_t mask;
+
+    s->regs[APM_SATA_DWC_INTPR / 4] |= APM_SATA_INTPR_DMAT;
+    /*
+     * A completed DW AHB-DMAC transfer has retired its channel and walked
+     * past its final linked-list item.  The Linux driver uses both facts to
+     * decide that its descriptor is complete; leaving LLP at the first item
+     * makes it deliberately keep the descriptor active.
+     */
+    s->dma_regs[APM_AHBDMA_CH_EN / 4] &= ~(1U << s->dma_channel);
+    s->dma_regs[APM_AHBDMA_CH_LLP(s->dma_channel) / 4] = 0;
+    s->dma_regs[APM_AHBDMA_CH_CTL_HI(s->dma_channel) / 4] = 0;
+    s->dma_regs[APM_AHBDMA_RAW_XFER / 4] |= 1U << s->dma_channel;
+    s->dma_running = false;
+
+    mask = s->dma_regs[APM_AHBDMA_MASK_XFER / 4];
+    qemu_set_irq(s->dma_irq,
+                 !!(s->dma_regs[APM_AHBDMA_RAW_XFER / 4] & mask));
+}
+
+static void apm821xx_sata_dma_set_inactive(const IDEDMA *dma, bool more)
+{
+    APM821xxSATAState *s = container_of(dma, APM821xxSATAState, dma);
+
+    s->dma_running = more;
+    if (!more) {
+        s->dma_cb = NULL;
+    }
+}
+
+static void apm821xx_sata_dma_start(const IDEDMA *dma, IDEState *ide,
+                                    BlockCompletionFunc *cb)
+{
+    APM821xxSATAState *s = container_of(dma, APM821xxSATAState, dma);
+
+    s->dma_cb = cb;
+    if (s->dma_running) {
+        cb(ide, 0);
+    }
+}
+
+static const IDEDMAOps apm821xx_sata_dma_ops = {
+    .start_dma = apm821xx_sata_dma_start,
+    .prepare_buf = apm821xx_sata_dma_prepare,
+    .commit_buf = apm821xx_sata_dma_commit,
+    .set_inactive = apm821xx_sata_dma_set_inactive,
+};
+
+static uint64_t apm821xx_sata_ahbdma_read(void *opaque, hwaddr addr,
+                                          unsigned size)
+{
+    APM821xxSATAState *s = opaque;
+
+    if (addr == APM_AHBDMA_STATUS_XFER) {
+        return s->dma_regs[APM_AHBDMA_RAW_XFER / 4] &
+               s->dma_regs[APM_AHBDMA_MASK_XFER / 4];
+    }
+    if (addr == APM_AHBDMA_STATUS_INT) {
+        return (s->dma_regs[APM_AHBDMA_RAW_XFER / 4] &
+                s->dma_regs[APM_AHBDMA_MASK_XFER / 4]);
+    }
+    if (addr < APM_AHBDMA_MMIO_SIZE && (addr & 3) == 0) {
+        return s->dma_regs[addr / 4];
+    }
+    return 0;
+}
+
+static void apm821xx_sata_ahbdma_write(void *opaque, hwaddr addr,
+                                       uint64_t value, unsigned size)
+{
+    APM821xxSATAState *s = opaque;
+    uint32_t val = value;
+
+    if (addr >= APM_AHBDMA_MMIO_SIZE || (addr & 3)) {
+        return;
+    }
+    if (addr >= APM_AHBDMA_MASK_XFER && addr <= APM_AHBDMA_MASK_ERROR &&
+        ((addr - APM_AHBDMA_MASK_XFER) % 8) == 0) {
+        uint32_t old = s->dma_regs[addr / 4];
+        uint32_t write_mask = (val >> 8) & 0xff;
+
+        s->dma_regs[addr / 4] = (old & ~write_mask) | (val & write_mask);
+        if (!(s->dma_regs[APM_AHBDMA_RAW_XFER / 4] &
+              s->dma_regs[APM_AHBDMA_MASK_XFER / 4])) {
+            qemu_set_irq(s->dma_irq, 0);
+        }
+    } else if (addr == APM_AHBDMA_CH_EN) {
+        uint32_t old = s->dma_regs[addr / 4];
+        uint32_t write_mask = (val >> 8) & 0xff;
+
+        /* CH_EN uses an upper-byte write-enable mask, it is not storage. */
+        s->dma_regs[addr / 4] = (old & ~write_mask) | (val & write_mask);
+    } else {
+        s->dma_regs[addr / 4] = val;
+    }
+    qemu_log_mask(LOG_UNIMP, "mbl-ahbdma: write %03" HWADDR_PRIx
+                  " = %08x\n", addr, val);
+
+    if (addr == APM_AHBDMA_CH_EN) {
+        /* Upper byte is the write-enable mask, lower byte the new value. */
+        uint32_t enabled = val & 0xff;
+        uint32_t write_mask = (val >> 8) & 0xff;
+        unsigned int ch;
+
+        for (ch = 0; ch < 8; ch++) {
+            if (write_mask & (1U << ch)) {
+                if (enabled & (1U << ch)) {
+                    s->dma_channel = ch;
+                    s->dma_running = true;
+                    qemu_log_mask(LOG_UNIMP,
+                                  "mbl-ahbdma: CH_EN channel%u=1 cb=%p"
+                                  " llp=%08x\n", ch, s->dma_cb,
+                                  s->dma_regs[APM_AHBDMA_CH_LLP(ch) / 4]);
+                    if (s->dma_cb) {
+                        s->dma_cb(ide_bus_active_if(&s->bus), 0);
+                    }
+                } else if (s->dma_channel == ch) {
+                    s->dma_running = false;
+                }
+            }
+        }
+    } else if (addr == APM_AHBDMA_CLEAR_XFER) {
+        uint32_t channels = val & 0xff;
+
+        s->dma_regs[APM_AHBDMA_RAW_XFER / 4] &= ~channels;
+        if (!(s->dma_regs[APM_AHBDMA_RAW_XFER / 4] &
+              s->dma_regs[APM_AHBDMA_MASK_XFER / 4])) {
+            qemu_set_irq(s->dma_irq, 0);
+        }
+    }
+}
+
+static const MemoryRegionOps apm821xx_sata_ahbdma_ops = {
+    .read = apm821xx_sata_ahbdma_read,
+    .write = apm821xx_sata_ahbdma_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = { .min_access_size = 4, .max_access_size = 4 },
+};
+
+static uint64_t apm821xx_sata_read(void *opaque, hwaddr addr,
+                                   unsigned size)
+{
+    APM821xxSATAState *s = opaque;
+
+    if (addr <= 0x1c && (addr & 3) == 0) {
+        if (addr == 0) {
+            return ide_data_readw(&s->bus, 0);
+        }
+        return ide_ioport_read(&s->bus, addr >> 2);
+    }
+    if (addr == 0x20) {
+        return ide_status_read(&s->bus, 0);
+    }
+    if (addr < APM_SATA_MMIO_SIZE && (addr & 3) == 0) {
+        return s->regs[addr / 4];
+    }
+    return 0;
+}
+
+static void apm821xx_sata_write(void *opaque, hwaddr addr,
+                                uint64_t value, unsigned size)
+{
+    APM821xxSATAState *s = opaque;
+
+    if (addr <= 0x1c && (addr & 3) == 0) {
+        if (addr == 0) {
+            ide_data_writew(&s->bus, 0, value);
+        } else {
+            ide_ioport_write(&s->bus, addr >> 2, value);
+        }
+        return;
+    }
+    if (addr == 0x20) {
+        ide_ctrl_write(&s->bus, 0, value);
+        return;
+    }
+    if (addr < APM_SATA_MMIO_SIZE && (addr & 3) == 0) {
+        if (addr == APM_SATA_DWC_INTPR) {
+            s->regs[addr / 4] &= ~value;
+            if (!s->regs[addr / 4]) {
+                qemu_set_irq(s->irq, 0);
+            }
+        } else {
+            s->regs[addr / 4] = value;
+        }
+    }
+}
+
+static const MemoryRegionOps apm821xx_sata_ops = {
+    .read = apm821xx_sata_read,
+    .write = apm821xx_sata_write,
+    /* sata_dwc_460ex uses readl/writel: the register block is little-endian. */
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = { .min_access_size = 1, .max_access_size = 4 },
+};
+
+static void apm821xx_sata_reset(DeviceState *dev)
+{
+    APM821xxSATAState *s = APM821XX_SATA(dev);
+
+    ide_bus_reset(&s->bus);
+    memset(s->regs, 0, sizeof(s->regs));
+    memset(s->dma_regs, 0, sizeof(s->dma_regs));
+    s->dma_cb = NULL;
+    s->dma_running = false;
+    s->dma_channel = UINT8_MAX;
+    s->regs[APM_SATA_SCR_BASE / 4] =
+        s->drive_present ? APM_SATA_SSTATUS_PRESENT : 0;
+    s->regs[APM_SATA_DWC_VERSIONR / 4] = 0x312e3300; /* "1.3" */
+    s->regs[APM_SATA_DWC_IDR / 4] = 0;
+    qemu_set_irq(s->irq, 0);
+    qemu_set_irq(s->dma_irq, 0);
+}
+
+static void apm821xx_sata_realize(DeviceState *dev, Error **errp)
+{
+    SysBusDevice *sbd = SYS_BUS_DEVICE(dev);
+    APM821xxSATAState *s = APM821XX_SATA(dev);
+
+    ide_bus_init(&s->bus, sizeof(s->bus), dev, 0, 1);
+    s->dma.ops = &apm821xx_sata_dma_ops;
+    s->ide_irq = qemu_allocate_irq(apm821xx_sata_ide_irq, s, 0);
+    ide_bus_init_output_irq(&s->bus, s->ide_irq);
+    /* ide_bus_init_output_irq installs the generic no-op DMA backend. */
+    s->bus.dma = &s->dma;
+    memory_region_init_io(&s->mmio, OBJECT(s), &apm821xx_sata_ops, s,
+                          "apm821xx-sata", APM_SATA_MMIO_SIZE);
+    sysbus_init_mmio(sbd, &s->mmio);
+    memory_region_init_io(&s->dma_mmio, OBJECT(s), &apm821xx_sata_ahbdma_ops,
+                          s, "apm821xx-ahbdma", APM_AHBDMA_MMIO_SIZE);
+    sysbus_init_mmio(sbd, &s->dma_mmio);
+    sysbus_init_irq(sbd, &s->irq);
+    sysbus_init_irq(sbd, &s->dma_irq);
+}
+
+static const VMStateDescription vmstate_apm821xx_sata = {
+    .name = "apm821xx-sata",
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .fields = (const VMStateField[]) {
+        VMSTATE_IDE_BUS(bus, APM821xxSATAState),
+        VMSTATE_IDE_DRIVES(bus.ifs, APM821xxSATAState),
+        VMSTATE_UINT32_ARRAY(regs, APM821xxSATAState,
+                             APM_SATA_MMIO_SIZE / sizeof(uint32_t)),
+        VMSTATE_END_OF_LIST()
+    }
+};
+
+static void apm821xx_sata_class_init(ObjectClass *oc, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(oc);
+
+    dc->realize = apm821xx_sata_realize;
+    device_class_set_legacy_reset(dc, apm821xx_sata_reset);
+    dc->vmsd = &vmstate_apm821xx_sata;
+}
+
+static const TypeInfo apm821xx_sata_info = {
+    .name = TYPE_APM821XX_SATA,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(APM821xxSATAState),
+    .class_init = apm821xx_sata_class_init,
+};
+
+static void apm821xx_sata_register_types(void)
+{
+    type_register_static(&apm821xx_sata_info);
+}
+
+type_init(apm821xx_sata_register_types)
+
+void apm821xx_sata_init_drive(DeviceState *dev, DriveInfo *drive)
+{
+    APM821xxSATAState *s = APM821XX_SATA(dev);
+    DeviceState *ide_dev;
+
+    if (drive) {
+        s->drive_present = true;
+        s->regs[APM_SATA_SCR_BASE / 4] = APM_SATA_SSTATUS_PRESENT;
+
+        /*
+         * Do not inherit QEMU's generic "QEMU HARDDISK" identity.  This is
+         * an emulated My Book Live disk, rather than a claim about the host
+         * image or a physical WD drive.
+         */
+        ide_dev = qdev_new(drive->media_cd ? "ide-cd" : "ide-hd");
+        qdev_prop_set_uint32(ide_dev, "unit", 0);
+        qdev_prop_set_drive_err(ide_dev, "drive", blk_by_legacy_dinfo(drive),
+                                &error_fatal);
+        qdev_prop_set_string(ide_dev, "model", "QEMU MBL SATA DISK");
+        qdev_prop_set_string(ide_dev, "ver", "1.0");
+        qdev_prop_set_string(ide_dev, "serial", "QEMU-MBL-0001");
+        qdev_realize_and_unref(ide_dev, &s->bus.qbus, &error_fatal);
+    }
+}
diff --git a/hw/net/ppc4xx_emac.c b/hw/net/ppc4xx_emac.c
new file mode 100644
index 0000000..68fcee1
--- /dev/null
+++ b/hw/net/ppc4xx_emac.c
@@ -0,0 +1,287 @@
+/* IBM EMAC4SYNC register and PHY front end for APM821xx. */
+#include "qemu/osdep.h"
+#include "hw/net/ppc4xx_emac.h"
+#include "hw/core/qdev-properties.h"
+#include "net/net.h"
+#include "qemu/module.h"
+#include "system/dma.h"
+
+#define EMAC_MR0   0x00
+#define EMAC_TMR0  0x08
+#define EMAC_STACR 0x5c
+#define MR0_SRST   0x20000000
+#define TMR0_GNP   0x80000000
+#define STACR_OC   0x00008000
+#define STACR_IND_READ  0x00003800
+#define STACR_IND_WRITE 0x00002800
+#define STACR_READ      0x00001000
+#define STACR_WRITE     0x00002000
+
+static uint16_t ppc4xx_emac_phy_read(unsigned int reg)
+{
+    switch (reg) {
+    case 0: return 0x1140; /* autonegotiation enabled */
+    case 1: return 0x786d; /* 10/100/1000 capable, autoneg complete, link */
+    case 2: return 0x001c;
+    case 3: return 0xc915;
+    case 4: return 0x01e1;
+    case 5: return 0x01e1;
+    case 9: return 0x0300;
+    case 10: return 0x0c00;
+    default: return 0;
+    }
+}
+
+static uint64_t ppc4xx_emac_read(void *opaque, hwaddr addr, unsigned size)
+{
+    PPC4xxEMACState *s = opaque;
+    return s->regs[addr >> 2];
+}
+
+void ppc4xx_emac_desc_reset(PPC4xxEMACState *s, bool tx, hwaddr desc)
+{
+    if (tx) {
+        s->tx_desc = desc;
+    } else {
+        s->rx_desc = desc;
+        ppc4xx_emac_rx_kick(s);
+    }
+}
+
+static bool ppc4xx_emac_rx_desc_ready(PPC4xxEMACState *s)
+{
+    uint8_t d[8];
+    hwaddr desc;
+
+    if (!s->mal) {
+        return false;
+    }
+    desc = s->rx_desc ? s->rx_desc : ppc4xx_mal_rx_desc(s->mal, 0);
+    if (!desc) {
+        return false;
+    }
+    dma_memory_read(&address_space_memory, desc, d, sizeof(d),
+                    MEMTXATTRS_UNSPECIFIED);
+    return !!(lduw_be_p(d) & 0x8000);
+}
+
+/* Guest-owned MAL descriptors change in RAM without an MMIO notification. */
+static void ppc4xx_emac_schedule_rx_retry(PPC4xxEMACState *s)
+{
+    timer_mod(s->rx_retry_timer,
+              qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) + 1000000LL);
+}
+
+static void ppc4xx_emac_rx_retry(void *opaque)
+{
+    PPC4xxEMACState *s = opaque;
+
+    qemu_flush_queued_packets(qemu_get_queue(s->nic));
+    if (!ppc4xx_emac_rx_desc_ready(s)) {
+        ppc4xx_emac_schedule_rx_retry(s);
+    }
+}
+
+static bool ppc4xx_emac_can_receive(NetClientState *nc)
+{
+    PPC4xxEMACState *s = qemu_get_nic_opaque(nc);
+
+    if (!ppc4xx_emac_rx_desc_ready(s)) {
+        ppc4xx_emac_schedule_rx_retry(s);
+        return false;
+    }
+    return true;
+}
+
+void ppc4xx_emac_rx_kick(PPC4xxEMACState *s)
+{
+    if (s->nic) {
+        qemu_flush_queued_packets(qemu_get_queue(s->nic));
+        if (!ppc4xx_emac_rx_desc_ready(s)) {
+            ppc4xx_emac_schedule_rx_retry(s);
+        }
+    }
+}
+
+static void ppc4xx_emac_tx(PPC4xxEMACState *s)
+{
+    uint8_t d[8];
+    int n;
+
+    if (!s->mal) {
+        return;
+    }
+    if (!s->tx_desc) {
+        s->tx_desc = ppc4xx_mal_tx_desc(s->mal, 0);
+    }
+    for (n = 0; n < 64; n++) {
+        uint16_t ctrl, len;
+        uint32_t data;
+        uint8_t *pkt;
+
+        dma_memory_read(&address_space_memory, s->tx_desc, d, sizeof(d),
+                        MEMTXATTRS_UNSPECIFIED);
+        ctrl = lduw_be_p(d);
+        len = lduw_be_p(d + 2);
+        data = ldl_be_p(d + 4);
+        if (!(ctrl & 0x8000)) {
+            break;
+        }
+        pkt = g_malloc(len);
+        dma_memory_read(&address_space_memory, data, pkt, len,
+                        MEMTXATTRS_UNSPECIFIED);
+        qemu_send_packet(qemu_get_queue(s->nic), pkt, len);
+        g_free(pkt);
+        ctrl &= ~0x8000;
+        stw_be_p(d, ctrl);
+        dma_memory_write(&address_space_memory, s->tx_desc, d, sizeof(d),
+                         MEMTXATTRS_UNSPECIFIED);
+        s->tx_desc = (ctrl & 0x4000) ? ppc4xx_mal_tx_desc(s->mal, 0) :
+                     s->tx_desc + sizeof(d);
+    }
+    if (n) {
+        ppc4xx_mal_tx_complete(s->mal, 0);
+    }
+}
+
+static void ppc4xx_emac_write(void *opaque, hwaddr addr, uint64_t val,
+                               unsigned size)
+{
+    PPC4xxEMACState *s = opaque;
+    uint32_t v = val;
+
+    if (addr == EMAC_STACR) {
+        /* has-inverted-stacr-oc: clear marks every MDIO operation complete. */
+        v &= ~STACR_OC;
+    }
+
+    if (addr == EMAC_MR0 && (v & MR0_SRST)) {
+        memset(s->regs, 0, sizeof(s->regs));
+        if (s->mal) {
+            s->tx_desc = ppc4xx_mal_tx_desc(s->mal, 0);
+            s->rx_desc = ppc4xx_mal_rx_desc(s->mal, 0);
+        }
+        return; /* reset completes synchronously */
+    }
+    if (addr == EMAC_TMR0 && (v & TMR0_GNP)) {
+        ppc4xx_emac_tx(s);
+    }
+    if (addr == EMAC_STACR &&
+        ((v & STACR_READ) || ((v & 0x00003800) == STACR_IND_WRITE) ||
+         (v & STACR_WRITE))) {
+        unsigned reg = (v >> 5) & 0x1f;
+        if (v & STACR_READ) {
+            v = (v & 0xffff) | ((uint32_t)ppc4xx_emac_phy_read(reg) << 16);
+        }
+    }
+    s->regs[addr >> 2] = v;
+}
+
+static const MemoryRegionOps ppc4xx_emac_ops = {
+    .read = ppc4xx_emac_read, .write = ppc4xx_emac_write,
+    .endianness = DEVICE_BIG_ENDIAN,
+    .valid = { .min_access_size = 4, .max_access_size = 4 },
+};
+
+static ssize_t ppc4xx_emac_receive(NetClientState *nc, const uint8_t *buf,
+                                   size_t size)
+{
+    PPC4xxEMACState *s = qemu_get_nic_opaque(nc);
+    uint8_t d[8];
+    uint16_t ctrl, max_len;
+    uint32_t data;
+    size_t len;
+
+    if (!s->mal) {
+        return 0;
+    }
+    if (!s->rx_desc) {
+        s->rx_desc = ppc4xx_mal_rx_desc(s->mal, 0);
+    }
+    if (!s->rx_desc) {
+        ppc4xx_emac_schedule_rx_retry(s);
+        return 0;
+    }
+    dma_memory_read(&address_space_memory, s->rx_desc, d, sizeof(d),
+                    MEMTXATTRS_UNSPECIFIED);
+    ctrl = lduw_be_p(d);
+    max_len = ppc4xx_mal_rx_buf_size(s->mal, 0);
+    data = ldl_be_p(d + 4);
+    if (!(ctrl & 0x8000)) {
+        return 0;
+    }
+    len = MIN(size, max_len);
+    dma_memory_write(&address_space_memory, data, buf, len,
+                     MEMTXATTRS_UNSPECIFIED);
+    ctrl = (ctrl & 0x4000) | 0x1800; /* wrap, first, last */
+    stw_be_p(d, ctrl);
+    stw_be_p(d + 2, len);
+    dma_memory_write(&address_space_memory, s->rx_desc, d, sizeof(d),
+                     MEMTXATTRS_UNSPECIFIED);
+    s->rx_desc = (ctrl & 0x4000) ? ppc4xx_mal_rx_desc(s->mal, 0) :
+                 s->rx_desc + sizeof(d);
+    ppc4xx_mal_rx_complete(s->mal, 0);
+    return size;
+}
+
+static NetClientInfo ppc4xx_emac_net_info = {
+    .type = NET_CLIENT_DRIVER_NIC, .size = sizeof(NICState),
+    .can_receive = ppc4xx_emac_can_receive,
+    .receive = ppc4xx_emac_receive,
+};
+
+static void ppc4xx_emac_realize(DeviceState *dev, Error **errp)
+{
+    PPC4xxEMACState *s = PPC4XX_EMAC(dev);
+    qemu_macaddr_default_if_unset(&s->conf.macaddr);
+    s->nic = qemu_new_nic(&ppc4xx_emac_net_info, &s->conf,
+                          TYPE_PPC4XX_EMAC, dev->id,
+                          &dev->mem_reentrancy_guard, s);
+    qemu_format_nic_info_str(qemu_get_queue(s->nic), s->conf.macaddr.a);
+}
+
+static void ppc4xx_emac_init(Object *obj)
+{
+    PPC4xxEMACState *s = PPC4XX_EMAC(obj);
+    SysBusDevice *sbd = SYS_BUS_DEVICE(obj);
+    memory_region_init_io(&s->mmio, obj, &ppc4xx_emac_ops, s,
+                          "ppc4xx-emac", 0xc4);
+    sysbus_init_mmio(sbd, &s->mmio);
+    sysbus_init_irq(sbd, &s->irq);
+    s->rx_retry_timer = timer_new_ns(QEMU_CLOCK_VIRTUAL,
+                                     ppc4xx_emac_rx_retry, s);
+}
+
+static void ppc4xx_emac_finalize(Object *obj)
+{
+    PPC4xxEMACState *s = PPC4XX_EMAC(obj);
+
+    timer_free(s->rx_retry_timer);
+}
+
+static const Property ppc4xx_emac_properties[] = {
+    DEFINE_NIC_PROPERTIES(PPC4xxEMACState, conf),
+    DEFINE_PROP_LINK("mal", PPC4xxEMACState, mal, "ppc4xx-mal",
+                     Ppc4xxMalState *),
+};
+
+static void ppc4xx_emac_class_init(ObjectClass *oc, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(oc);
+    dc->realize = ppc4xx_emac_realize;
+    device_class_set_props(dc, ppc4xx_emac_properties);
+}
+
+static const TypeInfo ppc4xx_emac_info = {
+    .name = TYPE_PPC4XX_EMAC, .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(PPC4xxEMACState), .instance_init = ppc4xx_emac_init,
+    .instance_finalize = ppc4xx_emac_finalize,
+    .class_init = ppc4xx_emac_class_init,
+};
+
+static void ppc4xx_emac_register_types(void)
+{
+    type_register_static(&ppc4xx_emac_info);
+}
+
+type_init(ppc4xx_emac_register_types)
diff --git a/hw/ppc/mbl_apm821xx.c b/hw/ppc/mbl_apm821xx.c
